{
  "info": {
    "name": "Lead capture — WhatsApp webhook",
    "description": "Simulates Meta's WhatsApp Cloud API webhooks against the local service. Set appSecret = WA_APP_SECRET and verifyToken = WA_VERIFY_TOKEN from your .env. Send the 'Happy path' requests in order, a few seconds apart.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Runs before every request: fresh message ID + timestamp, and Meta's signature.",
          "const n = Number(pm.collectionVariables.get(\"counter\") || 0) + 1;",
          "pm.collectionVariables.set(\"counter\", n);",
          "pm.variables.set(\"msgId\", \"wamid.POSTMAN.\" + Date.now() + \".\" + n);",
          "pm.variables.set(\"ts\", Math.floor(Date.now() / 1000).toString());",
          "",
          "if (pm.request.method === \"POST\" && pm.request.body && pm.request.body.raw) {",
          "  // Sign exactly the bytes Postman will send (variables already filled in).",
          "  const body = pm.variables.replaceIn(pm.request.body.raw);",
          "  const secret = pm.collectionVariables.get(\"appSecret\");",
          "  let sig = CryptoJS.HmacSHA256(body, secret).toString(CryptoJS.enc.Hex);",
          "  if (pm.info.requestName.toLowerCase().includes(\"bad signature\")) {",
          "    sig = \"0\".repeat(64);",
          "  }",
          "  pm.request.headers.upsert({ key: \"X-Hub-Signature-256\", value: \"sha256=\" + sig });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"status is as expected\", function () {",
          "  const bad = pm.info.requestName.toLowerCase().includes(\"bad signature\");",
          "  pm.expect(pm.response.code).to.eql(bad ? 401 : 200);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "appSecret",
      "value": "same-as-WA_APP_SECRET-in-.env"
    },
    {
      "key": "verifyToken",
      "value": "same-as-WA_VERIFY_TOKEN-in-.env"
    },
    {
      "key": "tuteeNumber",
      "value": "919999900001"
    },
    {
      "key": "profileName",
      "value": "Priya"
    },
    {
      "key": "phoneNumberId",
      "value": "PHONE_NUMBER_ID"
    },
    {
      "key": "counter",
      "value": "0"
    }
  ],
  "item": [
    {
      "name": "0 Setup checks",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/healthz",
            "description": "Expect {\"status\": \"ok\", \"db\": \"ok\", \"outbox_pending\": 0}."
          }
        },
        {
          "name": "Webhook verification (Meta handshake)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/webhooks/whatsapp?hub.mode=subscribe&hub.verify_token={{verifyToken}}&hub.challenge=1158201444",
            "description": "What Meta calls when you click 'Verify and save'. Expect the body 1158201444. A wrong token gives 403."
          }
        }
      ]
    },
    {
